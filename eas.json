{
  "cli": {
    "version": ">= 19.0.8",
    "appVersionSource": "remote"
  },
  "build": {
    "qa": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "qa"
    },
    "uat": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "uat"
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "channel": "production"
    }
  }
}
